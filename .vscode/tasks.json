{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Generate Database",
            "type": "shell",
            "command": "bun generate::database"
        },
        {
            "label": "Port",
            "type": "shell",
            "command": "source .env && ngrok http 3000"
        },
        {
            "label": "Watch",
            "type": "shell",
            "command": "if [[ \"$OSTYPE\" == msys* || \"$OSTYPE\" == cygwin* ]]; then powershell -Command 'npm run watch'; else npm run watch; fi",
            "runOptions": {
                "runOn": "folderOpen"
            }
        }
    ]
}